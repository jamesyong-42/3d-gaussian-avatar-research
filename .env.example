# Optional. Copy to .env; real local paths stay out of Git.
# Paths may be absolute or relative to the repository root.
GSAVATAR_DATA_DIR=local/data

# Generation is opt-in. The synthetic demo needs none of these models.
GSAVATAR_ENABLE_GENERATION=0
GSAVATAR_LHM_ROOT=third_party/LHM
# Set to the Python executable inside your separately installed LHM environment.
# GSAVATAR_GENERATION_PYTHON=/absolute/path/to/lhm-env/bin/python
# On Windows use forward slashes, e.g. C:/models/lhm-env/Scripts/python.exe
# GSAVATAR_CUDA_HOME=/usr/local/cuda
GSAVATAR_LHM_500M_DIR=local/models/LHM-500M-HF
GSAVATAR_LHM_1B_DIR=generation-lab/checkpoints/LHM-1B-HF
GSAVATAR_LHMPP_DIR=generation-lab/checkpoints/LHMPP-700M-PixelShuffle

# Optional LHM++ Docker route. Set the reserve path to Docker's storage drive.
# GSAVATAR_DOCKER=docker
# GSAVATAR_DOCKER_RESERVE_PATH=/
# GSAVATAR_EXAMPLE_PHOTO=local/consented-example.png
